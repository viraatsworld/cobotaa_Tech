#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "pallet"
    doc = """Generated from Composed Stage of root layer /tmp/tmptszubmfz/pallet.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pallet_34mo3q_c/usdex_pallet/pallet.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pallet_34mo3q_c/temp_pallet/pallet.usd


Generated from Composed Stage of root layer /home/anm-vi/Techtory/src/techtory_cobotta_isaacsim/assets/objects/pallet/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pallet"
{
    over "Geometry"
    {
        over "pallet_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0.01975)
            float3 physics:diagonalInertia = (0.0914, 0.1868, 0.274)
            float physics:mass = 5
            quatf physics:principalAxes = (1, 0, 0, 0)
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </pallet>
            custom rel physics:body1
            prepend rel physics:body1 = </pallet/Geometry/pallet_base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

