<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main">
  <include path="subtrees/pnp_pipeline.xml"/>

  <BehaviorTree ID="main">
    <Sequence>
      <SubTree ID="pnp_pipeline"
               name="Pick Red Cube from bin to place on shelf"
               yaml_path="src/techtory_cobotta_system/config/poses.yaml"
               pick_approach="pick_red_approach"
               pick="pick_red"
               pick_retreat="pick_red_retreat"
               shelf_approach="shelf_approach"
               place_approach="place_red_approach"
               place="place_red"
               place_retreat="place_red_retreat"
               gripper_open_pos="-0.6"
               gripper_open_effort="0.1"
               gripper_close_pos="0.5"
               gripper_close_effort="0.1"
               _autoremap="true"/>
      <SubTree ID="pnp_pipeline"
               yaml_path="src/techtory_cobotta_system/config/poses.yaml"
               pick_approach="pick_green_approach"
               pick="pick_green"
               pick_retreat="pick_green_retreat"
               shelf_approach="shelf_green_approach"
               place_approach="place_green_approach"
               place="place_green"
               place_retreat="place_green_retreat"
               gripper_open_pos="-0.3"
               gripper_open_effort="0.1"
               gripper_close_pos="0.45"
               gripper_close_effort="0.1"
               _autoremap="true"/>
      <SubTree ID="execute_motion"
                 yaml_path="src/techtory_cobotta_system/config/poses.yaml"
                 pose_name="shelf_approach"
                 _autoremap="true"/>
      <SubTree ID="pnp_pipeline"
               yaml_path="src/techtory_cobotta_system/config/poses.yaml"
               pick_approach="place_red_approach"
               pick="place_red"
               pick_retreat="place_red_retreat"
               shelf_approach="shelf_approach"
               place_approach="pick_red_approach"
               place="pick_red"
               place_retreat="pick_red_retreat"
               gripper_open_pos="-0.0"
               gripper_open_effort="0.1"
               gripper_close_pos="0.5"
               gripper_close_effort="0.1"
               _autoremap="true"/>
      <SubTree ID="execute_motion"
                 yaml_path="src/techtory_cobotta_system/config/poses.yaml"
                 pose_name="shelf_green_approach"
                 _autoremap="true"/>
      <SubTree ID="pnp_pipeline"
               yaml_path="src/techtory_cobotta_system/config/poses.yaml"
               pick_approach="place_green_approach"
               pick="place_green"
               pick_retreat="place_green_retreat"
               shelf_approach="shelf_green_approach"
               place_approach="place_green_approach"
               place="place_green"
               place_retreat="place_green_retreat"
               gripper_open_pos="-0.3"
               gripper_open_effort="0.1"
               gripper_close_pos="0.45"
               gripper_close_effort="0.1"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
