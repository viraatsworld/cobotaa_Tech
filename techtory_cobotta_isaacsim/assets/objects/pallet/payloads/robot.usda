#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "pallet"
    doc = """Generated from Composed Stage of root layer /tmp/tmptszubmfz/pallet.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pallet_34mo3q_c/usdex_pallet/pallet.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pallet_34mo3q_c/temp_pallet/pallet.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pallet" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = </pallet/Physics/root_joint>
    prepend rel isaac:physics:robotLinks = </pallet/Geometry/pallet_base_link>
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "pallet_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

